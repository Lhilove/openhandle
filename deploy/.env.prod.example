# Production environment for the API stack.
#
# Copy to deploy/.env on the server (that file is gitignored) and fill in:
#   cp deploy/.env.prod.example deploy/.env && chmod 600 deploy/.env
#
# deploy/bootstrap.sh writes this file for you and generates the secrets.

# ---- Public addresses (must be the URLs a browser actually uses) ----
# Your Vercel deployment.
APP_BASE_URL=https://openhandle.vercel.app
# The API origin Caddy serves. Must match API_DOMAIN below.
API_BASE_URL=https://openhandle-api.example.com
# Exact browser origins allowed to make credentialed requests. No wildcards.
CORS_ALLOWED_ORIGINS=https://openhandle.vercel.app

# ---- TLS ----
# Hostname Caddy gets a certificate for. Must resolve to this server.
# Without your own domain, a free name works: <label>-<dashed-ip>.sslip.io
# or a DuckDNS subdomain you create.
API_DOMAIN=openhandle-api.example.com
# Certificate expiry notices are off by default. To enable them, add a global
# options block with `email you@example.com` to deploy/Caddyfile (see the
# comment at the top of that file) and add ACME_EMAIL to the caddy service
# environment in deploy/docker-compose.prod.yml.

# ---- Database ----
POSTGRES_USER=openhandle
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
POSTGRES_DB=openhandle

# ---- Sessions ----
# generate with: openssl rand -hex 32
# Rotating this signs everyone out.
SESSION_SECRET=generate-with-openssl-rand-hex-32

# ---- Proxying ----
# forwarded: trust the left-most X-Forwarded-For value, which the Vercel
# rewrite sets to the visitor's address. Use "remote" if you are not behind
# such a proxy, or if you set TRUSTED_PROXIES instead.
CLIENT_IP_MODE=forwarded
# lax: the browser only talks to the Vercel origin, so the session cookie is
# first-party. Set "none" only if the browser calls the API on a different
# registrable domain (and then check Safari, which blocks those cookies).
COOKIE_SAMESITE=lax

# ---- Optional: lock the origin to proxy traffic ----
# Leave empty to accept direct requests. To enable, set the same value here and
# as ORIGIN_SECRET in the Vercel project (see docs/DEPLOYMENT.md).
# generate with: openssl rand -hex 32
ORIGIN_SECRET=

# ---- Solana ----
# devnet | testnet | mainnet-beta
#
# Going to mainnet: change BOTH lines together. The API refuses to start when
# the label and a recognised RPC host disagree, because it would then publish
# "mainnet-beta" while reading status from another chain.
#   SOLANA_CLUSTER=mainnet-beta
#   SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- Optional: social identity (leave empty to disable) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Optional: local smoke tests only ----
# Change these to run the stack on a machine where 80/443 are taken.
# HTTP_PORT=8081
# HTTPS_PORT=8443

# ---- Logging ----
LOG_LEVEL=info
