# Frontend build-time configuration. Only PUBLIC values belong here.
# Vite exposes VITE_* to the browser bundle -- never put secrets in this file.

# Backend API base URL.
#
# Local development: point at the API's own port.
# VITE_API_BASE_URL=http://localhost:8090
#
# Leave this UNSET for a production build: the client then calls the API on its
# own origin (relative /api/v1 paths), which is how the deployed app works
# because Vercel rewrites /api/* to the API server. Keeping it unset is what
# makes the session cookie first-party, so only set it if you have deliberately
# put the API on a different registrable domain (and then expect Safari to block
# the cross-site cookie).
VITE_API_BASE_URL=

# Solana cluster label shown in the UI (devnet | testnet | mainnet-beta).
# Set it to mainnet-beta together with the server's SOLANA_CLUSTER: the API
# rejects a transaction whose network label does not match its own cluster.
VITE_SOLANA_CLUSTER=devnet

# RPC endpoint used by the browser wallet for building, sending and confirming
# transactions.
#
# If you change this host, add it -- as *both* https:// and wss:// -- to the
# connect-src list of the Content-Security-Policy in vercel.json. A missing
# wss:// entry is easy to miss because only the WebSocket paths break.
#
# This is a Vite build-time value: it is inlined into the bundle, so changing it
# in the Vercel dashboard has no effect until the project is redeployed.
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
