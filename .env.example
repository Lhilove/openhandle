# OpenHandle — environment template. Copy to .env and fill in.
# NEVER commit real credentials.

# ---- App ----
APP_ENV=development
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8080

# ---- Database ----
# Port 5433 matches docker-compose.yml (POSTGRES_PORT); change if you prefer 5432.
DATABASE_URL=postgres://openhandle:openhandle@localhost:5433/openhandle?sslmode=disable

# ---- Sessions / security ----
# Generate with: openssl rand -hex 32  (or: python -c "import secrets;print(secrets.token_hex(32))")
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Comma separated. Credentials are never combined with a wildcard origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# SameSite attribute on the session and OAuth state cookies: lax | strict | none.
# Keep lax whenever the browser reaches the API on the app's own origin (local
# development, or an edge proxy such as Vercel forwarding /api/*). Use none only
# when the browser calls the API on a *different registrable domain*: browsers
# then treat the cookie as third-party, Safari blocks it, and it must be Secure.
COOKIE_SAMESITE=lax

# How the client IP used for rate limiting is derived: remote | forwarded.
# remote    uses the TCP peer, honouring TRUSTED_PROXIES below (safe default).
# forwarded takes the left-most X-Forwarded-For value, for a proxy that
#           overwrites that header with the visitor's address (Vercel does).
CLIENT_IP_MODE=remote

# CIDRs of proxies whose X-Forwarded-For may be trusted (CLIENT_IP_MODE=remote).
# Example: TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8
TRUSTED_PROXIES=

# Optional shared secret that every request must present in X-Origin-Secret, so
# the API only accepts traffic that came through the edge proxy. Makes
# CLIENT_IP_MODE=forwarded spoof-proof. Generate with: openssl rand -hex 32
# Requires CLIENT_IP_MODE=forwarded. Leave blank to accept direct traffic.
ORIGIN_SECRET=

# ---- Solana ----
# devnet | testnet | mainnet-beta
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# ---- Optional social identity providers (leave blank to disable) ----
# Providers are shown as "Not configured" until both values are present.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---- Logging ----
LOG_LEVEL=info
